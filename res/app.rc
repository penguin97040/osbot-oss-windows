// Resources: icon, manifest and version info (language en-NZ, 0x1409).
#include <winver.h>
#include "version.h"

1 ICON "icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OSBOT_VERSION_MAJOR, OSBOT_VERSION_MINOR, OSBOT_VERSION_PATCH, 0
PRODUCTVERSION OSBOT_VERSION_MAJOR, OSBOT_VERSION_MINOR, OSBOT_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "140904b0"
        BEGIN
            VALUE "CompanyName", "osbot-oss-windows contributors"
            VALUE "FileDescription", "osbot-oss: open-source OBSBOT camera control (unofficial)"
            VALUE "FileVersion", OSBOT_VERSION_STRING
            VALUE "InternalName", "osbot-oss-windows"
            VALUE "LegalCopyright", "Copyright (c) 2026 penguin97040. MIT Licence."
            VALUE "OriginalFilename", "osbot-oss-windows.exe"
            VALUE "ProductName", "osbot-oss-windows"
            VALUE "ProductVersion", OSBOT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x1409, 1200
    END
END
